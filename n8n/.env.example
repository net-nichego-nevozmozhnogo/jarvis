# Домен и SSL (укажите ваш субдомен и почту)
N8N_HOSTNAME=n8n.yourdomain.com
SSL_EMAIL=your-email@example.com

# Настройки базы данных PostgreSQL
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=change_this_to_strong_password
POSTGRES_DB=n8n_db

# Общие настройки n8n
GENERIC_TIMEZONE=Europe/Moscow
# Случайный ключ шифрования (нужен n8n для безопасного хранения паролей и API-ключей)
N8N_ENCRYPTION_KEY=change_this_to_random_secret_string